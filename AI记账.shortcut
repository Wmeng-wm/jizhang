<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>WFWorkflowName</key>
    <string>AI记账</string>
    <key>WFWorkflowActions</key>
    <array>
        <!-- 1. 截屏 -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.takescreenshot</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000001</string>
            </dict>
        </dict>
        <!-- 2. 调整图像大小（宽度 600，高度自动等比） -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.image.resize</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000002</string>
                <key>WFInput</key>
                <dict>
                    <key>OutputUUID</key>
                    <string>A0000000-0000-0000-0000-000000000001</string>
                    <key>Aggrandizements</key>
                    <array/>
                </dict>
                <key>WFImageResizeWidth</key>
                <integer>600</integer>
            </dict>
        </dict>
        <!-- 3. 转换为 JPEG（质量 0.5） -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.image.convert</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000003</string>
                <key>WFInput</key>
                <dict>
                    <key>OutputUUID</key>
                    <string>A0000000-0000-0000-0000-000000000002</string>
                    <key>Aggrandizements</key>
                    <array/>
                </dict>
                <key>WFImageFormat</key>
                <string>JPEG</string>
                <key>WFImageCompressionQuality</key>
                <real>0.5</real>
                <key>WFImagePreserveMetadata</key>
                <false/>
            </dict>
        </dict>
        <!-- 4. Base64 编码（无换行） -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.base64encode</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000004</string>
                <key>WFInput</key>
                <dict>
                    <key>OutputUUID</key>
                    <string>A0000000-0000-0000-0000-000000000003</string>
                    <key>Aggrandizements</key>
                    <array/>
                </dict>
                <key>WFEncodeMode</key>
                <string>Encode</string>
                <key>WFBase64LineBreakMode</key>
                <string>None</string>
            </dict>
        </dict>
        <!-- 5. 上传 URL（服务器地址） -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.url</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000005</string>
                <key>WFURLActionURL</key>
                <string>https://ksjizhang.top/api/imgput</string>
            </dict>
        </dict>
        <!-- 6. 获取URL内容：POST JSON {b64: <Base64>} → 服务器返回短 ID -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.downloadurl</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000006</string>
                <key>WFInput</key>
                <dict>
                    <key>OutputUUID</key>
                    <string>A0000000-0000-0000-0000-000000000005</string>
                    <key>Aggrandizements</key>
                    <array/>
                </dict>
                <key>Advanced</key>
                <true/>
                <key>ShowHeaders</key>
                <false/>
                <key>WFHTTPMethod</key>
                <string>POST</string>
                <key>WFHTTPBodyType</key>
                <string>JSON</string>
                <key>WFJSONValues</key>
                <dict>
                    <key>Value</key>
                    <dict>
                        <key>WFDictionaryFieldValueItems</key>
                        <array>
                            <dict>
                                <key>WFItemType</key>
                                <integer>0</integer>
                                <key>WFKey</key>
                                <dict>
                                    <key>Value</key>
                                    <dict>
                                        <key>string</key>
                                        <string>b64</string>
                                    </dict>
                                    <key>WFSerializationType</key>
                                    <string>WFTextTokenString</string>
                                </dict>
                                <key>WFValue</key>
                                <dict>
                                    <key>Value</key>
                                    <dict>
                                        <key>attachmentsByRange</key>
                                        <dict>
                                            <key>{0, 1}</key>
                                            <dict>
                                                <key>OutputUUID</key>
                                                <string>A0000000-0000-0000-0000-000000000004</string>
                                                <key>OutputName</key>
                                                <string>Base64已编码内容</string>
                                                <key>Type</key>
                                                <string>ActionOutput</string>
                                            </dict>
                                        </dict>
                                        <key>string</key>
                                        <string>B</string>
                                    </dict>
                                    <key>WFSerializationType</key>
                                    <string>WFTextTokenString</string>
                                </dict>
                            </dict>
                        </array>
                    </dict>
                    <key>WFSerializationType</key>
                    <string>WFDictionaryFieldValue</string>
                </dict>
            </dict>
        </dict>
        <!-- 7. 拼接 URL：?id=<服务器返回的短ID> -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.text</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000007</string>
                <key>WFTextActionText</key>
                <dict>
                    <key>Value</key>
                    <dict>
                        <key>attachmentsByRange</key>
                        <dict>
                            <key>{26,1}</key>
                            <dict>
                                <key>OutputUUID</key>
                                <string>A0000000-0000-0000-0000-000000000006</string>
                                <key>OutputName</key>
                                <string>获取URL内容</string>
                                <key>Type</key>
                                <string>ActionOutput</string>
                            </dict>
                        </dict>
                        <key>string</key>
                        <string>https://ksjizhang.top/?id=K</string>
                    </dict>
                    <key>WFSerializationType</key>
                    <string>WFTextTokenString</string>
                </dict>
            </dict>
        </dict>
        <!-- 8. 打开 URL -->
        <dict>
            <key>WFWorkflowActionIdentifier</key>
            <string>is.workflow.actions.openurl</string>
            <key>WFWorkflowActionParameters</key>
            <dict>
                <key>UUID</key>
                <string>A0000000-0000-0000-0000-000000000008</string>
                <key>WFInput</key>
                <dict>
                    <key>OutputUUID</key>
                    <string>A0000000-0000-0000-0000-000000000007</string>
                    <key>Aggrandizements</key>
                    <array/>
                </dict>
            </dict>
        </dict>
    </array>
    <key>WFWorkflowClientVersion</key>
    <string>2400</string>
    <key>WFWorkflowMinimumClientVersion</key>
    <integer>900</integer>
    <key>WFWorkflowMinimumClientVersionString</key>
    <string>900</string>
    <key>WFWorkflowTypes</key>
    <array/>
    <key>WFWorkflowIcon</key>
    <dict>
        <key>WFWorkflowIconGlyphNumber</key>
        <integer>61444</integer>
        <key>WFWorkflowIconImageData</key>
        <data/>
        <key>WFWorkflowIconStartColor</key>
        <integer>4274264319</integer>
    </dict>
    <key>WFWorkflowImportQuestions</key>
    <array/>
    <key>WFWorkflowInputContentItemClasses</key>
    <array/>
</dict>
</plist>
